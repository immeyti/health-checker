# Copy this file to .env and fill in your values.
# The monitor will read these automatically at startup.

# Encrypts dashboard passwords of targets added from the web UI (required).
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it changes or is lost, passwords of UI-added dashboards can't be decrypted.
MONITOR_SECRET_KEY=

# Kavenegar SMS API
KAVENEGAR_API_KEY=your_kavenegar_api_key_here

# Twilio SMS API (if using Twilio instead)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Telegram bot (if using the telegram channel)
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here

# Dashboard credentials (referenced in config.yaml as ${VAR_NAME})
GRAFANA_PASSWORD=your_grafana_password
# KIBANA_PASSWORD=your_kibana_password
